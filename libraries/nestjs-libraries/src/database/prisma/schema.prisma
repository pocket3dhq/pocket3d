generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person who signs in. Signup also creates their own Organization, which
// owns the models and API keys (teams can come later)
model User {
  id        String    @id @default(uuid())
  email     String    @unique // always stored lowercased
  name      String?
  password  String // scrypt$N$r$p$salt$hash (services/password.ts), never leaves the server
  activated Boolean   @default(true) // false until the email link is opened (only with an email provider)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organizations UserOrganization[]
  sessions      Session[]
  authTokens    AuthToken[]
  apiKeys       ApiKey[]
  oauthGrants   OAuthGrant[]
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users         UserOrganization[]
  apiKeys       ApiKey[]
  assets        Asset[]
  uploadTickets UploadTicket[]
  oauthGrants   OAuthGrant[]
}

enum Role {
  ADMIN
  USER
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(ADMIN)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// A browser login. The cookie holds a random secret; only its sha256 is
// stored, so a database leak doesn't hand out sessions
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// What the CLI and agents send. Shown once at creation; only the sha256 is kept
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  prefix         String // first characters of the key, so people can tell keys apart
  keyHash        String       @unique
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

enum AuthTokenType {
  ACTIVATE
  RESET
}

// Single-use links sent by email (activation, password reset)
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

// A published 3D model. The id is also the share link: MAIN_URL/m/<id>.
// The files live in its versions (AssetVersion); the link shows the live one
model Asset {
  id             String         @id // 12-char crypto-random base62 (makeId), unguessable
  organizationId String? // null: published before accounts existed (nobody can change it)
  title          String
  // Last version number handed out (drafts included). Only goes up, so a
  // number is never reused. Incremented in the transaction that adds a version
  lastNumber     Int            @default(0)
  // Last upload or publish: the owner's list puts recently changed models first
  activityAt     DateTime       @default(now())
  // What /m/<id> shows. Always a published, non-deleted version of this asset
  // (AssetVersionsService keeps it so, under a row lock)
  liveVersionId  String?        @unique
  liveVersion    AssetVersion?  @relation("live", fields: [liveVersionId], references: [id], onDelete: SetNull)
  versions       AssetVersion[] @relation("versions")
  // Legacy, from before versions: copied into each model's v1 by the
  // asset_versions migration and no longer read or written. Dropped in a
  // later release, once production is verified
  name           String?
  path           String?
  fileSize       Int?
  coverName      String?
  coverPath      String?
  coverSize      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  organization   Organization?  @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, deletedAt, activityAt])
}

// Where a version came from: an icon in the versions panel (null: published
// before versions existed)
enum VersionSource {
  DASHBOARD
  API
  MCP
}

// A draft is private (only the owner sees it) and can't be live until it is
// published. DRAFT → PUBLISHED only
enum VersionStatus {
  DRAFT
  PUBLISHED
}

// One uploaded file of a model: v1, v2... Its files never change after the
// upload; only the note can be edited. Addressed by (assetId, number), never
// by its id outside the server
model AssetVersion {
  id          String        @id @default(uuid())
  assetId     String
  number      Int
  name        String // storage key of the .glb (never leaves the server)
  path        String // public URL of the .glb
  fileSize    Int
  coverName   String? // storage key of the cover image (never leaves the server)
  coverPath   String? // public URL of the cover image (link previews)
  coverSize   Int? // bytes; with fileSize, counts toward MAX_STORAGE_PER_ORG_MB
  note        String? // what changed, up to 280 characters; public once published
  status      VersionStatus @default(PUBLISHED)
  publishedAt DateTime? // null while a draft
  source      VersionSource?
  sourceName  String? // the API key or connected app that sent it: shown to the owner only
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  asset       Asset         @relation("versions", fields: [assetId], references: [id])
  liveOf      Asset?        @relation("live")

  @@unique([assetId, number])
  @@index([assetId, deletedAt, status, number])
}

// A single-use upload link (MCP create_upload_link): lets an agent with a
// shell send a local file with curl, without ever seeing an API key. Only the
// sha256 of the token is kept
model UploadTicket {
  id             String        @id @default(uuid())
  organizationId String
  tokenHash      String        @unique
  title          String?
  // Set: the link adds a version to this model (checked to belong to the org
  // when the link is made, and again when it is used) instead of a new model
  assetId        String?
  draft          Boolean       @default(false) // only with assetId
  note           String?
  source         VersionSource @default(MCP)
  sourceName     String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([expiresAt])
}

// An app that registered itself (OAuth dynamic client registration, RFC 7591):
// Claude, Cursor, Codex... connecting to the MCP server. PKCE is always
// required; a client that asks for a secret gets one (only its sha256 is kept)
model OAuthClient {
  id                      String       @id @default(uuid())
  clientId                String       @unique
  clientSecretHash        String?
  tokenEndpointAuthMethod String       @default("none") // none | client_secret_post | client_secret_basic
  name                    String
  redirectUris            String[]
  createdAt               DateTime     @default(now())
  grants                  OAuthGrant[]
}

// One "Allow" on the consent page: the code, then the tokens it turned into.
// Code, access and refresh tokens are stored as sha256 only
model OAuthGrant {
  id               String       @id @default(uuid())
  clientId         String
  userId           String
  organizationId   String
  codeHash         String?      @unique
  codeExpiresAt    DateTime?
  codeChallenge    String
  redirectUri      String
  accessTokenHash  String?      @unique
  accessExpiresAt  DateTime?
  refreshTokenHash String?      @unique
  refreshExpiresAt DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  client           OAuthClient  @relation(fields: [clientId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
}
