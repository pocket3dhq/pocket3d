{
  "name": "pocket3d-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Publish a 3D model from the terminal (or your AI agent), get a link anyone can open.",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm run --filter ./apps/backend --filter ./apps/frontend --parallel dev",
    "build": "pnpm -r --workspace-concurrency=1 --filter ./apps/backend --filter ./apps/frontend --filter ./apps/cli run build",
    "build:backend": "rm -rf apps/backend/dist && pnpm --filter ./apps/backend run build",
    "build:frontend": "rm -rf apps/frontend/.next && pnpm --filter ./apps/frontend run build",
    "build:cli": "rm -rf apps/cli/dist && pnpm --filter ./apps/cli run build",
    "dev:backend": "pnpm --filter ./apps/backend run dev",
    "dev:frontend": "pnpm --filter ./apps/frontend run dev",
    "start:prod:backend": "pnpm --filter ./apps/backend run start",
    "start:prod:frontend": "pnpm --filter ./apps/frontend run start",
    "dev:docker": "docker compose -f ./docker-compose.dev.yaml up -d",
    "prisma-generate": "prisma generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-migrate-dev": "dotenv -e .env -- prisma migrate dev --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-migrate-deploy": "prisma migrate deploy --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "typecheck": "tsc -p apps/backend/tsconfig.build.json --noEmit && tsc -p apps/frontend/tsconfig.json --noEmit && tsc -p apps/cli/tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint apps libraries",
    "test": "pnpm build:cli && jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "postinstall": "pnpm run prisma-generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^10.0.0",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "multer": "^2.5.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sass": "^1.89.2",
    "swr": "^2.5.1",
    "tailwindcss": "3.4.17",
    "three": "0.187.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/supertest": "^6.0.3",
    "@types/three": "0.187.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "jest": "^29.7.0",
    "postcss": "8.5.26",
    "prettier": "^2.6.2",
    "prisma": "6.5.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.0",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "multer": "^2.5.0",
      "next": "16.4.6"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
