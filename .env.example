# pocket3d configuration. Copy to .env for `pnpm dev`.
# The Docker setup (docker-compose.yaml) sets them itself.

# === Required Settings
DATABASE_URL="postgresql://pocket3d-local:pocket3d-local-pwd@localhost:5439/pocket3d-db-local"

# === This needs to be exactly the URL people open pocket3d on.
# Share links are MAIN_URL/m/<id>. In `pnpm dev` that's the Next.js dev server.
MAIN_URL="http://localhost:4200"

# Where the Next.js server reaches the backend (same machine)
BACKEND_INTERNAL_URL="http://localhost:3000"

# === Accounts
# People sign up at MAIN_URL/auth/register and create API keys (for the CLI
# and agents) at MAIN_URL/dashboard/keys. Set to "true" to close signup: the
# very first account can still be created, so you can lock your own instance.
#DISABLE_REGISTRATION="true"

# What one account may keep stored (model files + covers), in MB. Unset:
# unlimited. pocket3d.co (the cloud version) sets it.
#MAX_STORAGE_PER_ORG_MB="500"

# === Email (optional). With RESEND_API_KEY set, signup needs an emailed
# activation link and "forgot password" works. Without it, accounts are active
# at once and passwords can't be reset by email.
#RESEND_API_KEY="re_..."
#EMAIL_FROM_ADDRESS="hello@your-domain.com"   # on a domain verified in Resend
#EMAIL_FROM_NAME="pocket3d"

# === Storage: "local" (a folder on this machine) or "cloudflare" (R2)
STORAGE_PROVIDER="local"

# local: where files are written (an absolute path: the backend and the
# frontend run from different folders). Served at MAIN_URL/uploads/...
UPLOAD_DIRECTORY="/absolute/path/to/pocket3d/uploads"

# cloudflare: an R2 bucket made public through a custom domain.
# Create an R2 API token with "Object Read & Write" on the bucket.
#CLOUDFLARE_ACCOUNT_ID="your-account-id"
#CLOUDFLARE_ACCESS_KEY="your-access-key"
#CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
#CLOUDFLARE_BUCKETNAME="your-bucket-name"
## the bucket's public URL (custom domain), e.g. https://files.example.com
#CLOUDFLARE_BUCKET_URL="https://files.example.com"

# === Behind a proxy (optional)
# The visitor IP for rate limits comes from nginx (X-Real-IP). If a proxy in
# front sets its own header and nothing else can reach this server, name it,
# e.g. Cloudflare: cf-connecting-ip. Unset: never trust such a header.
#TRUSTED_IP_HEADER="cf-connecting-ip"

# === Optional
# Shows a GitHub link on the home page and viewer footer when set
#REPO_URL=""
# Shown on the home page as the demo link when set (a MAIN_URL/m/<id> link)
#DEMO_URL=""
